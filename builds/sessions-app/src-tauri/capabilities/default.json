{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "COSMOS Sessions — loopback shell + Python sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "sessions-app-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
