---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/news/</loc></url>
  <url><loc>{{ site.url }}/resources/</loc></url>
  <url><loc>{{ site.url }}/word-lists/</loc></url>
  <url><loc>{{ site.url }}/forum/</loc></url>
  <url><loc>{{ site.url }}/about/</loc></url>
  <url><loc>{{ site.url }}/privacy/</loc></url>
{%- for post in collections.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | isoDate }}</lastmod></url>
{%- endfor %}
</urlset>
